# Supabase (wajib)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Nomor WhatsApp untuk pairing code (format internasional tanpa +)
PHONE_NUMBER=6281234567890

# Dashboard admin — dipakai untuk membuat akun SUPERADMIN pertama kali (bootstrap).
# Selanjutnya semua akun (superadmin & 6 admin kelurahan) dikelola dari menu
# "Akun Admin" di dashboard. Password tersimpan sebagai hash scrypt di Supabase.
ADMIN_USER=admin
ADMIN_PASS=ganti-dengan-password-kuat

# PORT diisi otomatis oleh Railway; gunakan hanya untuk lokal jika perlu.
# PORT=3000

# Opsional: hasil ekspor kredensial auth dalam base64 untuk deployment tanpa volume.
# AUTH_CREDS=
